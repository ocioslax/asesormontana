# Configuración de Entorno - Asesor de Seguridad en Alta Montaña

# API Key de Google Gemini (Obligatoria para llamadas reales a Gemini Pro)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Puerto de ejecución del servidor Uvicorn
PORT=8080

# Restricciones de consumo para no superar el Free Tier de Google Gemini
GEMINI_MAX_RPM=10
GEMINI_MAX_RPD=200
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_INPUT_CHARS=24000
GEMINI_CACHE_TTL_SECONDS=900
GEMINI_COOLDOWN_ON_429_SECONDS=60

