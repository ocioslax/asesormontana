# API Key de Google Gemini (Obligatoria para llamadas reales a Gemini Pro)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Puerto de ejecución del servidor Uvicorn
PORT=8000

# Parámetros para despliegue en Vercel (Opcionales para CI/CD)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
